{
  "name": "mission-control-widget",
  "productName": "Mission Control",
  "version": "1.0.0",
  "description": "Futuristic top-center Windows widget with an animated pet, live PC stats, speed test, cache cleaner and Claude Code chat",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/build-macos.js",
    "test": "node --test test/*.test.js",
    "package:mac": "node scripts/package-macos.js"
  },
  "keywords": [
    "electron",
    "windows",
    "widget",
    "system-monitor",
    "speed-test",
    "cache-cleaner",
    "claude-code",
    "desktop-pet"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Shadhin-f/mission-control-widget.git"
  },
  "license": "MIT",
  "os": [
    "win32",
    "darwin"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^45.5.0"
  },
  "optionalDependencies": {
    "koffi": "^3.3.8"
  }
}

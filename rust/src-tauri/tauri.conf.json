{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mission Control",
  "version": "1.0.0",
  "identifier": "com.missioncontrol.widget",
  "build": {
    "frontendDist": "../../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Futuristic top-center widget with an animated pet, live PC stats and more",
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
